# Vercel Environment Variables - Frontend
# These are the environment variables you need to set in Vercel project settings

# Backend API URL (set this in Vercel's Environment Variables section)
# For monorepo setup, this will be your backend Vercel deployment URL
VITE_API_BASE_URL=https://your-backend-api.vercel.app

# Full API URL (same as VITE_API_BASE_URL for API calls)
VITE_API_URL=https://your-backend-api.vercel.app

# App configuration
VITE_APP_NAME=MusicApp
VITE_APP_ENV=production

# Database configuration (if you need direct DB access)
# VERCEL_POSTGRES_URL (set in Vercel dashboard)
# VERCEL_KV_REST_API_URL (for KV storage)
# VERCEL_KV_REST_API_TOKEN (for KV storage)

# Store Configuration
# Use Vercel KV for session storage and caching
VITE_STORE_TYPE=kv

# CORS origins are configured on the backend
VITE_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app